FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN test ! -e vercel.json && grep -Fx 'Hosting: Cloudflare only. Never Vercel or Netlify.' AGENTS.md
RUN node --check scripts/verification-target.mjs && node --check debug-live.mjs && node --check debug-playwright.mjs && node --check debug-playwright2.mjs && node --check check-template.mjs && node --check test-version.mjs
RUN --network=none npm run build
RUN test -s .next/BUILD_ID && test -s .next/server/app-paths-manifest.json
RUN node -e "const assert=require('node:assert/strict');const manifest=require('./.next/server/functions-config-manifest.json');const routes=['/api/analyze-frames','/api/extract','/api/extract-stream','/api/extract-video','/api/template/[id]'];for(const route of routes)assert.equal(manifest.functions[route]?.maxDuration,120,route);console.log('All five API route duration limits preserved');"
